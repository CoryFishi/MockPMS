{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint -- *)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "enabledMcpjsonServers": [
    "supabase-mockpms"
  ]
}
